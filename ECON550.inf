    334   ! Trade indexes !
    335   File (new)
    336       Index # File with trade indexes #;
    337    
    338   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    339       EXPORTSir(i,r) # Exports by commodity i and region r #;
    340   Formula (all,i,TRAD_COMM)(all,r,REG)
    341       EXPORTSir(i,r) = sum(s, REG, VIWS(i,r,s));
    342    
    343   Coefficient (all,r,REG)
    344       EXPORTSr(r) # Exports by region r #;
    345   Formula (all,r,REG)
    346       EXPORTSr(r) = sum(i, TRAD_COMM, EXPORTSir(i,r));
    347    
    348   Coefficient (all,i,TRAD_COMM)
    349       EXPORTSi(i) # Total Exports of commodity i #;
    350   Formula (all,i,TRAD_COMM)
    351       EXPORTSi(i) = sum(r, REG, EXPORTSir(i,r));
    352    
    353   Coefficient
    354       EXPORTS_wld # World Exports #;
    355   Formula
    356       EXPORTS_wld = sum(r, REG, sum(i, TRAD_COMM, EXPORTSir(i,r)));
    357    
    358   Coefficient (all,r,REG)
    359       IMPORTSr(r) # Imports #;
    360   Formula (all,r,REG)
    361       IMPORTSr(r) = sum(i, TRAD_COMM, sum(rr, REG, VIWS(i,rr,r)));
    362    
    363   Coefficient (all,r,REG)
    364       GDP(r) # GDP #;
    365   Formula (all,r,REG)
    366       GDP(r) = sum(k,GDPSOURCE, GDPSRC(r,k));
    367    
    368   Coefficient (all,r,REG)
    369       OPENESS(r) # Openness #;
    370   Formula (all,r,REG)
    371       OPENESS(r) = (EXPORTSr(r) + IMPORTSr(r))
    372                  / GDP(r);
    373    
    374   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    375       RCA(i,r) # Revealed comparative advantage #;
    376   Formula (all,i,TRAD_COMM)(all,r,REG)
    377       RCA(i,r) = (EXPORTSir(i,r) / EXPORTSr(r))/(EXPORTSi(i)/EXPORTS_wld) ;
    378    
    379   Coefficient (all,e,ENDW_COMM)(all,i,TRAD_COMM)(all,r,REG)
    380       FactInt(e,i,r) # Factor Intensity #;
    381   Formula (all,e,ENDW_COMM)(all,i,TRAD_COMM)(all,r,REG)
    382       FactInt(e,i,r) = VFM(e,i,r) / sum(ee, ENDW_COMM, VFM(ee,i,r));
    383    
    384   Coefficient (all,e,ENDW_COMM)(all,i,TRAD_COMM)
    385       avFactInt(e,i) # average world Factor Intensity #;
    386   Formula (all,e,ENDW_COMM)(all,i,TRAD_COMM)
    387       avFactInt(e,i) = sum(r, REG, VFM(e,i,r))
    388               / sum(r, REG, sum(ee, ENDW_COMM, VFM(ee,i,r)));
    389    
    390   set RCAlabel (Exports,RCA) ;
    391   set avlabel (av) ;
    392   set avENDW = avlabel x ENDW_COMM;
    393   MAPPING (PROJECT) MAPAVENDW from avENDW to ENDW_COMM ;
    394    
    395   set tdindexes0 = RCAlabel + ENDW_COMM;
    396   set tdindexes1 = tdindexes0 + avENDW;
    397    
    398   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,k,tdindexes1)
    399       TRAD_INDEXES(i,r,k) # various trade indexes in table #;
    400   Formula (all,i,TRAD_COMM)(all,r,REG)
    401       TRAD_INDEXES(i,r,"Exports") = EXPORTSir(i,r);
    402   Formula (all,i,TRAD_COMM)(all,r,REG)
    403       TRAD_INDEXES(i,r,"RCA") = RCA(i,r);
    404    Formula (all,i,TRAD_COMM)(all,r,REG)(all,e,ENDW_COMM)
    405       TRAD_INDEXES(i,r,e) = FactInt(e,i,r);
    406    Formula (all,i,TRAD_COMM)(all,r,REG)(all,e,avENDW)
    407       TRAD_INDEXES(i,r,e) = avFactInt(MAPAVENDW(e),i);
    408    
    409   write OPENESS to file index header "OPEN";
    410   write TRAD_INDEXES to file index header "TIDX";
    411    
    412   ! IO tables !
    413   File (new)
    414       IOtable # File with IO tables #;
    415    
    416   set DOM (d_) ;
    417   set IMP (m_) ;
    418   set ExpTax (exptax) ;
    419   set Marg (marg) ;
    420   set Tarf (tariff) ;
    421   set SalTax (salestax) ;
    422   set FUseT (factuseTax) ;
    423   set ProdTax (prodtax) ;
    424   set PrivCons (priv) ;
    425   set GovtCons (gov) ;
    426   set Invest (inv) ;
    427   set Exports (export) ;
    428    
    429   set DTRAD = DOM x TRAD_COMM;
    430   set MTRAD = IMP x TRAD_COMM;
    431   MAPPING (PROJECT) MAPD from DTRAD to TRAD_COMM ;
    432   MAPPING (PROJECT) MAPM from MTRAD to TRAD_COMM ;
    433    
    434   set ROWS = DTRAD + MTRAD + ENDW_COMM + ExpTax + Marg + Tarf + SalTax + FUseT + ProdTax ;
    435   set COLS = TRAD_COMM + PrivCons + Invest + Exports ;
    436    
    437   Coefficient (all,o,ROWS)(all,c,COLS)(all,r,REG)
    438       IOT(o,c,r) #IO tables by region# ;
    439   Formula (all,o,ENDW_COMM)(all,c,TRAD_COMM)(all,r,REG)
    440       IOT(o,c,r) = EVFM(o,c,r);
    441   Formula (all,o,DTRAD)(all,c,TRAD_COMM)(all,r,REG)
    442       IOT(o,c,r) = VDFM(MAPD(o),c,r);
    443   Formula (all,o,MTRAD)(all,c,TRAD_COMM)(all,r,REG)
    444       IOT(o,c,r) = VIFM(MAPM(o),c,r);
    445   Formula (all,o,DTRAD)(all,c,PrivCons)(all,r,REG)
    446       IOT(o,c,r) = VDPM(MAPD(o),r);
    447   Formula (all,o,MTRAD)(all,c,PrivCons)(all,r,REG)
    448       IOT(o,c,r) = VIPM(MAPM(o),r);
    449   Formula (all,o,DTRAD)(all,c,Invest)(all,r,REG)
    450       IOT(o,c,r) = sum(j, CGDS_COMM, VDFM(MAPD(o),j,r));
    451   Formula (all,o,MTRAD)(all,c,Invest)(all,r,REG)
    452       IOT(o,c,r) = sum(j, CGDS_COMM, VIFM(MAPM(o),j,r));
    453   Formula (all,o,DTRAD)(all,c,Exports)(all,r,REG)
    454       IOT(o,c,r) = EXPORTSir(MAPD(o),r);
    455    
    456   write IOT to file IOtable header "IOT";
    457    
    458   !<
    459       ------------------------
    460       End of GTAPVIEW.TAB file
    461       ------------------------
    462   >!
