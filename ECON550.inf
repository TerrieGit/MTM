    144    
    145   Coefficient (all,i,DEMD_COMM)(all,j,PROD_COMM)(all,r,REG)
    146       VFM(i,j,r) # Firm's expenditure on i by industry j #;
    147   Formula (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
    148       VFM(i,j,r) = EVFM(i,j,r);
    149   Formula (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,s,REG)
    150       VFM(i,j,s) = VDFM(i,j,s) + VIFM(i,j,s);
    151   Coefficient (all,i,NSAV_COMM)(all,r,REG)
    152       VOM(i,r) # Value of commodity i output in region r #;
    153   Formula (all,i,ENDW_COMM)(all,r,REG)
    154       VOM(i,r) = sum(j, PROD_COMM, VFM(i,j,r));
    155   Formula (all,i,PROD_COMM)(all,r,REG)
    156       VOM(i,r) = sum{j,DEMD_COMM, VFM(j,i,r)};
    157    
    158   Coefficient (all,r,REG)
    159       VEXPORTS(r)
    160       # Value of merchandise and services sales to the world market from r #;
    161   Formula (all,r,REG)
    162       VEXPORTS(r)
    163           = sum{i,TRAD_COMM, sum{s,REG, VIWS(i,r,s)}};
    164    
