     14                  intensity indexes for GTAPmini model data
     15    
     16       --------------------------------------
     17       Overview of the GTAPVIEW.TAB structure
     18       --------------------------------------
     19       FILE declaration
     20       SET declaration
     21       READ statements of Base Data
     22       Derivatives of the Base Data
     23       Write statements of the Derivatives
     24    
     25   >!
     26    
     27   !<
     28       -----
     29       FILES
     30       -----
     31   >!
     32    
     33   File
     34       GTAPDATA # File containing all base data #;
     35   File
     36       GTAPSETS # File with set specification #;
     37   File
     38       GTAPPARM # File containing behavioral prameters #;
     39      ! above not actually used, but must leave in !
     40    
     41   !<
     42       ----
     43       SETS
     44       ----
     45   >!
     46    
     47   Set
     48       REG # Regions in the model #
     49       maximum size 10 read elements from file GTAPSETS header "H1";
     50   Set
     51       TRAD_COMM # Traded commodities #
     52       maximum size 10 read elements from file GTAPSETS header "H2";
     53   Set
     54       CGDS_COMM # Capital goods commodities #
     55       maximum size 1  read elements from file GTAPSETS header "H9";
     56   Set
     57       ENDW_COMM # Endowment commodities #
     58       maximum size 5  read elements from file GTAPSETS header "H6";
     59   Set
     60       ENDWC_COMM # Capital Endowment Commodity # (capital);
     61   Set
     62       PROD_COMM # PRODUCED COMMODITIES  # = TRAD_COMM union CGDS_COMM;
     63   Set
     64       DEMD_COMM # DEMANDED COMMODITIES # = ENDW_COMM union TRAD_COMM;
     65   Set
     66       NSAV_COMM # NON-SAVINGS COMMODITIES # = DEMD_COMM union CGDS_COMM;
     67   Subset
     68       PROD_COMM is subset of NSAV_COMM;
     69   Subset
     70       ENDWC_COMM is subset of NSAV_COMM;
     71    
     72   !<
     73       ----------------------------
     74       READ statements of Base Data
     75       ----------------------------
     76    
     77       base revenues and expenditures at agent's prices
     78       ------------------------------------------------
     79   >!
     80    
     81   Coefficient (all,r,REG)
     82       SAVE(r) # Expenditure on NET savings in region r valued at agent's prices #;
     83   Read
     84       SAVE from file GTAPDATA header "SAVE";
     85    
     86   Coefficient (all, r, REG)
     87       VDEP(r) # Value of capital depreciation in r (exogenous) #;
     88   Read
     89       VDEP from file GTAPDATA header "VDEP";
     90    
     91   !<
     92       base revenues and expenditures at prices
     93       ----------------------------------------
     94   >!
     95    
     96   Coefficient (all,i,ENDW_COMM)(all,j,PROD_COMM)(all,r,REG)
     97       EVFM(i,j,r) # Producer expenditure on i by j in r at market prices #;
     98   Read
     99       EVFM from file GTAPDATA header "EVFM";
    100    
    101   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    102       VIFM(i,j,r) # Purchases of imports i for use in j in region r #;
    103   Read
    104       VIFM from file GTAPDATA header "VIFM";
    105    
    106   Coefficient (all,i,TRAD_COMM)(all,j,PROD_COMM)(all,r,REG)
    107       VDFM(i,j,r) # Purchases of domestic i r for use in j in region r #;
    108   Read
    109       VDFM from file GTAPDATA header "VDFM";
    110    
    111   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    112       VIPM(i,r) # Private household expenditure on i in r #;
    113   Read
    114       VIPM from file GTAPDATA header "VIPM";
    115    
    116   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    117       VDPM(i,r) # Private household expenditure on domestic i in r #;
    118   Read
    119       VDPM from file GTAPDATA header "VDPM";
    120    
    121   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    122       VIMS(i,r,s) # Imports of i from r to s valued at domestic mkt prices #;
    123   Read
    124       VIMS from file GTAPDATA header "VIMS";
    125    
    126   Coefficient (all,i,TRAD_COMM)(all,r,REG)(all,s,REG)
    127       VIWS(i,r,s) # Imports of i from r to s valued cif (tradeables only) #;
    128   Read
