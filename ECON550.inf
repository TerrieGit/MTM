    166       VIMPORTS(s)
    167       # Value of merchandise and services purchases from world market by s #;
    168   Formula (all,s,REG)
    169       VIMPORTS(s) = sum{i,TRAD_COMM, sum{r,REG, VIWS(i,r,s)}};
