    295    
    296   Coefficient (all,i, TRAD_COMM)(all,r, REG)
    297       SUFFICIENCY(i,r) # Region's r rate of self-sufficiency for good i #;
    298   Formula (all,i, TRAD_COMM)(all,r, REG)
    299       SUFFICIENCY(i,r) = VOM(i,r) / [VDM(i,r) + sum{s,REG, VIMS(i,s,r)}];
