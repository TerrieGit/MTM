    181    
    182   Set GDPSOURCE(fact,tax,depr);
    183    
    184   Coefficient (all,r,REG)
    185       NETFACTINC(r) # Factor income, net of depreciation #;
    186   Formula (all,r,REG)
    187       NETFACTINC(r) = sum{i,ENDW_COMM, VOM(i,r)} - VDEP(r);
    188    
    189   Coefficient (all,i,TRAD_COMM)(all,r,REG)
    190       VDM(i,r) # Domestic sales of i in r at market prices (tradeables only) #;
    191   Formula (all,i,TRAD_COMM)(all,r,REG)
    192       VDM(i,r) = VDPM(i,r) + sum{j,PROD_COMM, VDFM(i,j,r)};
    193    
    194   Coefficient (all,r,REG)
    195       NETAXES(r) # Net tax revenues in r #;
    196   Formula (all,r,REG)
    197       NETAXES(r)
    198           = sum{i,TRAD_COMM, sum{s,REG, VIMS(i,s,r) - VIWS(i,s,r)}};
    199    
    200   Coefficient (all,r,REG)(all,k,GDPSOURCE)
    201       GDPSRC(r,k) # Composition of GDP from the sources side #;
    202   Formula (all,r,REG)
    203       GDPSRC(r,"fact") = NETFACTINC(r);
    204   Formula (all,r,REG)
    205       GDPSRC(r,"tax") = NETAXES(r);
    206   Formula (all,r,REG)
    207       GDPSRC(r,"depr") = VDEP(r);
    208    
    209   Coefficient (all, r, REG)
    210       NETINV(r) # Regional net investment in region r #;
    211   Formula (all, r, REG)
    212       NETINV(r) = REGINV(r) - VDEP(r);
